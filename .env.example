# Copy to .env and fill in. Use FRESH test wallets — never ones holding real funds.
DEPLOYER_PRIVATE_KEY=
# Arbitrum Sepolia RPC for scripts and fork tests. Forking an older block needs an archive endpoint.
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Ethereum mainnet RPC for the Arbitrum One BOLD fork tests. Unset uses a public endpoint (an empty value would not).
# ETH_RPC_URL=
# The keeper is permissionless: any funded testnet key works (falls back to DEPLOYER_PRIVATE_KEY).
KEEPER_PRIVATE_KEY=
# scripts/selfServe.ts signs with the first of RELAYER_PRIVATE_KEY, KEEPER_PRIVATE_KEY, DEPLOYER_PRIVATE_KEY that is set.
RELAYER_PRIVATE_KEY=
# Created by `node scripts/demo/gaslessExit.ts setup <usdg>` for the gasless demo (holds no ETH on Arbitrum Sepolia).
SELLER_PRIVATE_KEY=
# A second wallet that buys listings in the recorded demo (`node video/capture/record.ts buy-listing`); needs a
# little Arbitrum Sepolia ETH and USDG.
BUYER_PRIVATE_KEY=
