{
  "name": "exit-market",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:Mohamed-Aaftaab/Exit-Market",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:sol": "hardhat test solidity",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "test:fork": "FORK_TESTS=1 hardhat test solidity",
    "test:web": "node --test \"web/src/**/*.test.ts\"",
    "test:lib": "node --test \"scripts/lib/*.test.ts\"",
    "typecheck": "tsc --noEmit && npx next typegen web && tsc --noEmit -p web",
    "abis": "hardhat build && node scripts/dev/exportAbis.ts"
  },
  "devDependencies": {
    "@arbitrum/sdk": "^4.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "ethers": "^5.8.0",
    "forge-std": "github:foundry-rs/forge-std#v1.10.0",
    "hardhat": "^3.18.0",
    "playwright-core": "^1.63.0",
    "typescript": "5.9",
    "viem": "^2.57.0",
    "wabt": "^1.0.39"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "workspaces": [
    "web"
  ]
}
