# Optional. Without these the app reads the live contracts from ../deployments/arbitrumSepolia.json,
# so a fresh clone runs with `npm run web:dev` and no configuration at all.

# Point the app at other deployments (checksummed addresses).
NEXT_PUBLIC_EXIT_MARKET=
NEXT_PUBLIC_EXIT_VAULT=
NEXT_PUBLIC_EXIT_INTENT_ROUTER=
# Block the market above was deployed at (listing scans start there).
NEXT_PUBLIC_MARKET_DEPLOY_BLOCK=

# Server-only: the key the /api/relay route settles gasless exits with. It needs a little Arbitrum Sepolia ETH
# for gas and earns each order's relayer fee. Leave empty to disable the relayer (the route then returns 503).
# Use a fresh TESTNET key; it can never take a seller's funds (the signed order fixes buyer and minimum proceeds).
RELAYER_PRIVATE_KEY=

# Footer links (optional).
NEXT_PUBLIC_REPO_URL=https://github.com/Mohamed-Aaftaab/Exit-Market
NEXT_PUBLIC_DEMO_VIDEO_URL=
